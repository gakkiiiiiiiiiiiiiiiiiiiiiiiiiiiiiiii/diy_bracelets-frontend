# 后端 API 基础地址，配置后材料/分类从接口拉取（H5 与小程序均生效），未配置则使用 Mock
# H5：可配为 http://localhost:3000 等
# 小程序：须为 https 且需在微信公众平台「开发 - 开发管理 - 开发设置 - 服务器域名」中配置 request 合法域名
# VITE_API_BASE=https://your-api.com
# H5 演示默认无后端时使用本地 Mock；如需联调本地后端，设置为 false 并配置 VITE_PROXY_TARGET
# VITE_USE_MOCK_API=false
# VITE_PROXY_TARGET=http://localhost:3008

# 微信小程序云托管接口（选择云托管时必须显式填写完整一对，不提供隐式生产默认值）
VITE_WXCLOUD_CONTAINER_ENV=
VITE_WXCLOUD_CONTAINER_SERVICE=

# 过程视频依赖后端无头浏览器与可访问的 H5 渲染页，前后端都显式启用后才展示入口。
VITE_DESIGN_PROCESS_VIDEO_ENABLED=false

# 微信 AppID 与 AppSecret 只能配置在 backend，严禁写入 VITE_* 或小程序构建产物。
